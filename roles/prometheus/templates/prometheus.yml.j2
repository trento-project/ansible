global:
  scrape_interval: 30s
  evaluation_interval: 10s
scrape_configs:
  - job_name: "http_sd_hosts"
    honor_timestamps: true
    scrape_interval: 30s
    scrape_timeout: 30s
    scheme: http
    follow_redirects: true
    http_sd_configs:
    - follow_redirects: true
      refresh_interval: 1m
      url: {{ prometheus_web_url }}:{{ prometheus_web_listen_port }}/api/prometheus/targets
